# Docker images
DOCKERHUB_NAMESPACE=ultimatedpv4
IMAGE_TAG=latest

# Ports publics
GATEWAY_PORT=8000
AUTH_PORT=8001
CASES_PORT=8002
WORKFLOW_PORT=8003
IMAGES_PORT=8004
REPORTS_PORT=8005

# PostgreSQL
POSTGRES_USER=pixtral_user
POSTGRES_PASSWORD=pixtral_pass
POSTGRES_DB=postgres

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT
JWT_SECRET_KEY=change-me-super-secret-key

# Services internes
AUTH_SERVICE_URL=http://auth-service:8001
CASES_SERVICE_URL=http://cases-service:8002
WORKFLOW_SERVICE_URL=http://workflow-service:8003
IMAGES_SERVICE_URL=http://images-service:8004
REPORTS_SERVICE_URL=http://reports-service:8005

# Optionnel
QDRANT_ENABLED=true
INSTANTSEG_ENABLED=true
ORTHANC_ENABLED=false